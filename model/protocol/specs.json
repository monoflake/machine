{
	"specs": [
		{
			"name": "update",
			"module": "update.tla",
			"quick": "update.cfg",
			"inputs": ["model/protocol/update.tla", "model/protocol/update.cfg"],
			"switches": [
				{ "name": "RECORD_BEFORE_FLUSH", "breaks": "RecordedBoots" },
				{ "name": "FREEZE_SKIPPED", "breaks": "RecordedBoots" },
				{ "name": "ADOPT_UNSWITCHED", "breaks": "RecordedBoots" },
				{ "name": "FREEZE_FAILED_RECORDS", "breaks": "RecordedBoots" },
				{ "name": "RECORD_BEFORE_FLUSH", "breaks": "Converges" }
			],
			"temporal": ["Converges"],
			"export": {
				"command": ["node", "model/protocol/update_runs.res.mjs", "{output}"],
				"file": "model/protocol/update-runs.json",
				"checks": ["Runs"],
				"inputs": ["model/protocol/update_runs.res.mjs"]
			}
		},
		{
			"name": "powercut",
			"module": "powercut.tla",
			"quick": "powercut.cfg",
			"inputs": ["model/protocol/powercut.tla", "model/protocol/powercut.cfg"],
			"switches": [
				{ "name": "DEFAULT_BEFORE_REST", "breaks": "WholeBoot" },
				{ "name": "RECORD_BEFORE_REST", "breaks": "RecordedBoots" },
				{ "name": "OVERWRITE_OLD", "breaks": "WholeBoot" }
			],
			"export": {
				"command": ["node", "model/protocol/update_runs.res.mjs", "{output}"],
				"file": "model/protocol/powercut-runs.json",
				"checks": ["Runs"],
				"inputs": ["model/protocol/update_runs.res.mjs"]
			}
		}
	]
}
